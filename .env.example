# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://ufaamqrlmplidunrfdsv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed for `npm run seed`. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Shown across the app
NEXT_PUBLIC_COLLEGE_NAME="[College Name]"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=ssb.scaler.com

# Live program pipeline
FIRECRAWL_API_KEY=
# Comma-separated SSB emails allowed to approve updates at /admin/review
ADMIN_EMAILS=
# Random string; Vercel Cron sends it as a Bearer token to /api/cron/ingest
CRON_SECRET=

# AI provider: "gemini" or "anthropic" (defaults to Gemini when GEMINI_API_KEY is set)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-pro-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
# Gap between Gemini calls in batch jobs (free tier). Set 0 once billing is on.
AI_MIN_INTERVAL_MS=6500
ANTHROPIC_MODEL=claude-sonnet-5-5

# Idea Bank: TrustMRR official API (needs TrustMRR written permission before enabling the source)
TRUSTMRR_API_KEY=
